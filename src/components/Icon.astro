---
// Inline line icons (decorative, aria-hidden). Colour follows currentColor.
interface Props { name: "phone" | "route" | "menu" | "close" | "facebook"; class?: string; }
const { name, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {name === "phone" && <path d="M5.5 3.5h3l1.5 4-2 1.5a11 11 0 0 0 7 7l1.5-2 4 1.5v3a2 2 0 0 1-2 2A16 16 0 0 1 3.5 5.5a2 2 0 0 1 2-2Z" />}
  {name === "route" && <><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.4" /></>}
  {name === "menu" && <><path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h10" /></>}
  {name === "close" && <><path d="M6 6l12 12" /><path d="M18 6L6 18" /></>}
  {name === "facebook" && <path d="M14.5 8.5H17V5h-2.5A3.5 3.5 0 0 0 11 8.5V11H8.5v3.5H11V21h3.5v-6.5H17l.5-3.5h-3V8.5Z" />}
</svg>
